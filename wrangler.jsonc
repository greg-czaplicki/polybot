{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tanstack-start-app",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "src/server.ts",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "POLYWHALER_DB",
			"database_name": "polywhaler-db",
			"database_id": "5c45f749-3557-4307-8384-c499fe2f5359",
			"preview_database_id": "5c45f749-3557-4307-8384-c499fe2f5359"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "SHARP_PIPELINE",
				"class_name": "SharpPipeline"
			}
		]
	},
	"queues": {
		"producers": [
			{
				"binding": "SHARP_PIPELINE_QUEUE",
				"queue": "sharp-pipeline"
			}
		],
		"consumers": [
			{
				"queue": "sharp-pipeline",
				"max_batch_size": 1,
				"max_batch_timeout": 30,
				"max_retries": 3
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_classes": ["SharpPipeline"]
		}
	],
	"env": {
		"preview": {
			"d1_databases": [
				{
					"binding": "POLYWHALER_DB",
					"database_name": "polywhaler-db",
					"database_id": "5c45f749-3557-4307-8384-c499fe2f5359",
					"preview_database_id": "5c45f749-3557-4307-8384-c499fe2f5359",
					"remote": true
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "SHARP_PIPELINE",
						"class_name": "SharpPipeline"
					}
				]
			},
			"queues": {
				"producers": [
					{
						"binding": "SHARP_PIPELINE_QUEUE",
						"queue": "sharp-pipeline"
					}
				],
				"consumers": [
					{
						"queue": "sharp-pipeline",
						"max_batch_size": 1,
						"max_batch_timeout": 30,
						"max_retries": 3
					}
				]
			}
		}
	},
	// Set secrets using: wrangler secret put APP_PASSWORD / APP_AUTH_SECRET / BOT_API_KEY / BOT_CONTROL_TOKEN / BOT_CONTROL_ACCESS_ID / BOT_CONTROL_ACCESS_SECRET / BOT_CONTROL_URL
	"triggers": {
		"crons": [
			"*/2 * * * *"
		]
	}
}
